---
import Footer from "../components/elements/Footer.astro";
import Navbar from "../components/elements/Navbar.astro";

export interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!DOCTYPE html>
<html lang="pl">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width">
    <title>Tworzenie stron i sklepów internetowych na najwyższym poziomie | Dev2chola</title>
    <link rel="preload" href="/images/image1.webp" as="image"><meta name="google-site-verification" content="Za1EIvrtDAh3NwsbUiqGY_LO4JFAuvD7OvE41_DSZJk" />
    <link rel="canonical" href="https://dev2chola.pl/">
    <link rel="icon" type="image/svg+xml" href="/favicon.svg">
    <meta name="description" content="Potrzebujesz profesjonalnej strony? Stworzymy dla Ciebie efektowny i skuteczny e-biznes! Twoje zadowolenie – nasz priorytet. Tuchola i okolice.">
  </head>
  <body class="overflow-hidden overflow-y-auto bg-body">
    <Navbar />
    <slot />
    <Footer />
	<script is:inline>
	  const toggleMenu = document.querySelector("[data-toggle-nav]");
	  const navbar = document.querySelector("[data-navbar]");
	  const overlayNav = document.querySelector("[data-nav-overlay]");
	  const body = document.body;
	
	  const toggleMenuState = (isOpen) => {
	      if(toggleMenu){
	           toggleMenu.setAttribute("data-open-nav", isOpen.toString());
	      }
	    
	    if(overlayNav){
	        overlayNav.setAttribute("data-is-visible", isOpen.toString());
	    }
	    
	    body.classList.toggle("!overflow-y-hidden", isOpen);
	     if(navbar){
	        navbar.style.height = isOpen ? `${navbar.scrollHeight}px` : "0px";
	    }
	  };
	    
	  const handleClickOutside = () => {
	    toggleMenuState(false);
	  };
	
	  if (toggleMenu) {
	    if (!(toggleMenu instanceof HTMLButtonElement)) {
	      console.error("Element with data-toggle-nav is not a button");
	      return;
	    }
	
	    toggleMenu.addEventListener("click", (e) => {
	      e.preventDefault();
	      const isOpen = toggleMenu.getAttribute("data-open-nav") === "false";
	      toggleMenuState(isOpen);
	    });
	  }
	
	  if (navbar) {
	      if(!(navbar instanceof HTMLDivElement)){
	           console.error("Element with data-navbar is not a div");
	           return;
	        }
	    navbar.addEventListener("click", handleClickOutside);
	  }
	
	  if (overlayNav) {
	      if(!(overlayNav instanceof HTMLDivElement)){
	           console.error("Element with data-nav-overlay is not a div");
	           return;
	        }
	    overlayNav.addEventListener("click", handleClickOutside);
	  }
	</script>

  </body>
 
</html>
<style is:global>
  :root {
    --color-bg: 255 255 255;
    --color-border: 255 255 255;
    --color-box: 255 255 255;
    --box-border: 229 231 235;
    --box-sd: 226 232 240 / 0.5;
	--heading-1:  23 37 84;
	--heading-2: 31 41 55;
	--heading-3: 55 65 81;
  }

  .dark {
    --color-bg: 3 7 18;
    --color-box: 17 24 39;
    --box-border: 243 244 246/0.1;
    --box-sd: transparent;

	
	--heading-1:  255 255 255;
	--heading-2:  243 244 246;
	--heading-3:  209 213 219;
  }

  html{
    scroll-behavior: smooth;
  }
  body {
    font-family: "Raleway", sans-serif;
  }

  [data-toggle-nav][data-open-nav="true"] #line1 {
    transform: translateY(0.375rem) rotate(40deg);
  }
  [data-toggle-nav][data-open-nav="true"] #line2 {
    transform: scaleX(0);
    opacity: 0;
  }
  [data-toggle-nav][data-open-nav="true"] #line3 {
    transform: translateY(-0.375rem) rotate(-40deg);
  }

  
  [data-nav-overlay][data-is-visible="true"] {
    visibility: visible;
    display: flex;
  }
</style>
