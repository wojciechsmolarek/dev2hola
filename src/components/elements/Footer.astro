---
<div class="mt-16"></div>
<footer class="relative  bg-gradient-to-tr from-gray-100 to-gray-200 dark:from-gray-900 pt-28 rounded-t-3xl">
    <div class="absolute right-0 top-0 h-full w-full flex justify-end">
        <div class="w-28 h-28 overflow-auto flex rounded-xl relative blur-2xl">
            <span
              class="absolute w-16 h-16 -top-1 -right-1 bg-green-500 rounded-md rotate-45"
            ></span>
            <span
              class="absolute w-16 h-16 -bottom-1 -right-1 bg-[#FCDC58] rounded-md rotate-45"
            ></span>
            <span
              class="absolute w-16 h-16 -bottom-1 -left-1 bg-primary rounded-md rotate-45"
            ></span>
          </div>
      </div>

      <div class="absolute left-0 bottom-0 h-full w-full flex items-end">
        <div class="w-28 h-28 overflow-auto flex rounded-xl relative blur-2xl">
            <span
              class="absolute w-16 h-16 -top-1 -right-1 bg-green-500 rounded-md rotate-45"
            ></span>
            <span
              class="absolute w-16 h-16 -bottom-1 -right-1 bg-[#FCDC58] rounded-md rotate-45"
            ></span>
            <span
              class="absolute w-16 h-16 -bottom-1 -left-1 bg-primary rounded-md rotate-45"
            ></span>
          </div>
      </div>
    <Container className="pb-8 relative">
        <ul class="flex justify-content items-center gap-6 md:text-lg text-heading-3"> 
            <li> 
                <a href="/#" class="transition hover:text-primary"> Regulamin </a> 
            </li>
            <li> 
                <a href="#" class="transition hover:text-primary"> Polityka prywatności </a> 
            </li>
            <li> 
                <a href="#" class="transition hover:text-primary"> Polityka cookies </a> 
            </li> 
        </ul>
    </Container>
    <div class=" bg-gradient-to-tl from-box-bg py-2 relative">
        <Container>
            <div class="flex justify-between items-center gap-6 md:text-lg text-heading-3 flex-col lg:flex-row">
                <div>
                    &copy; <span id="year"></span> Dev2chola. Wszelkie prawa zastrzeżone.
                </div>
                <div>
                    Projekt i wykonanie: <a href="https://www.wojciechsmolarek.pl/" target="_blank" rel="noopener" class="font-semibold">Wojciech Smolarek</a>
                </div>
            </div>
        </Container>
    </div>
</footer>
