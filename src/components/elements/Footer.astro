        itemLink:"#"
    }
]

const footerSupport = [
    {
        itemText:"Cennik",
        itemLink:"#"
    },
    {
        itemText:"Poradniki",
        itemLink:"#"
    },
    {
        itemText:"FAQ",
        itemLink:"#"
    },
    {
